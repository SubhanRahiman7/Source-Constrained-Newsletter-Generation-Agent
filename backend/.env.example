# Comma-separated browser origins allowed to call this API (e.g. a custom domain).
# *.vercel.app is allowed by default via CORS_VERCEL_REGEX (override with empty to disable).
# ALLOWED_ORIGINS=

# Regex for extra origins (default matches all https://*.vercel.app). Set to empty to disable.
# CORS_VERCEL_REGEX=

# Optional: LLM for newsletter generation (JSON mode). If unset, the backend uses
# excerpt-only fallback generation (still fully cited, no external knowledge).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
