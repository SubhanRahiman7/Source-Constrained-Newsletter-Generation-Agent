# Comma-separated browser origins allowed to call this API (production frontend).
# Example: https://my-app.vercel.app,https://my-app-git-main-user.vercel.app
# ALLOWED_ORIGINS=

# Optional: LLM for newsletter generation (JSON mode). If unset, the backend uses
# excerpt-only fallback generation (still fully cited, no external knowledge).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
